# ==============================================================
# AMBIENTE LOCAL — ToggleMaster
# ==============================================================
# Copie este arquivo para .env antes de executar o Docker Compose.
#
# Windows (PowerShell): Copy-Item .env.example .env
# Linux/macOS:          cp .env.example .env
#
# Este modelo contém apenas valores locais e públicos. Nunca coloque
# credenciais reais da AWS, senhas de produção ou endpoints privados aqui.
# ==============================================================

# Portas publicadas na máquina do usuário.
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# PostgreSQL local. Estes valores existem apenas nos containers locais.
POSTGRES_USER=toggle
POSTGRES_PASSWORD=toggle-local-only
AUTH_DB=auth_db
FLAGS_DB=flags_db
TARGETING_DB=targeting_db

# URLs dos bancos dentro da rede criada pelo Docker Compose.
AUTH_DATABASE_URL=postgres://toggle:toggle-local-only@postgres-auth:5432/auth_db
FLAGS_DATABASE_URL=postgres://toggle:toggle-local-only@postgres-app:5432/flags_db
TARGETING_DATABASE_URL=postgres://toggle:toggle-local-only@postgres-app:5432/targeting_db

# Chave administrativa conhecida apenas para o laboratório local.
# Em qualquer ambiente compartilhado ou de produção, gere outro valor.
MASTER_KEY=local-master-key-change-me

# Comunicação interna entre os containers.
AUTH_SERVICE_URL=http://auth-service:8001
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003
REDIS_URL=redis://redis:6379

# DynamoDB Local. O container é iniciado pelo Compose.
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
AWS_REGION=us-east-2

# O SQS fica desativado no ambiente local. O docker-compose.yaml injeta uma
# URL vazia no evaluation-service e no analytics-service.
AWS_SQS_URL=

# Valores fictícios exigidos pelo SDK quando ele aponta para o DynamoDB Local.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# IMPORTANTE: deixe vazio na primeira inicialização.
# Depois que os containers estiverem saudáveis, crie uma chave em
# POST /admin/keys, cole o valor abaixo e recrie o evaluation-service.
# O passo a passo completo está no README.md.
SERVICE_API_KEY=
