*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# .terraform.lock.hcl NAO entra aqui: o lock DEVE ser versionado para que
# todo o grupo use a mesma versao de provider. Recomendacao da HashiCorp.
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

